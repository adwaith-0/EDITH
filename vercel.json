{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm run build"
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "entrypoint": "server/index.js",
      "buildCommand": "npm run db:generate",
      "functions": {
        "server/index.js": {
          "maxDuration": 300,
          "memory": 2048,
          "includeFiles": "{server/data/**,node_modules/kokoro-js/voices/af_heart.bin,node_modules/onnxruntime-node/bin/napi-v3/linux/x64/*.{node,so,so.*}}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/socket.io/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
