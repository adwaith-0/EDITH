# Copy to .env.local and .env. Never commit either file.
DATABASE_URL=postgresql://edith:edith_local_only@127.0.0.1:54329/edith_charge
JWT_SECRET=replace-with-a-long-random-local-secret
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
PORT=3001
BOOKING_RESPONSE_MINUTES=120
# Local MVP only: accepts any typed vehicle/connector and public booking simulations.
# Disable both flags before a real compatibility-checked rollout.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
# Optional text interpretation, server only. Never prefix this key with NEXT_PUBLIC.
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:20b
# Optional label-photo drafting; use a vision-capable model from ollama.com/api/tags.
OLLAMA_VISION_MODEL=gemma4:31b
# No Google Maps key required. Optional no-key map provider overrides:
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_GEOCODER_URL=https://photon.komoot.io/api/
MAP_ROUTER_URL=https://router.project-osrm.org/route/v1/driving/
# Optional public directory provider:
OPENCHARGEMAP_API_KEY=
# Optional override; otherwise cached OSM Overpass queries use two public endpoints.
# OVERPASS_API_URL=https://overpass-api.de/api/interpreter
